# Converts the bundled TTF fonts into a C source file with byte arrays.
function(embed_file path name out_var)
  file(READ ${path} hex HEX)
  string(LENGTH "${hex}" hex_len)
  math(EXPR size "${hex_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  set(${out_var} "const unsigned char ${name}[] = {${bytes}};\nconst unsigned int ${name}_size = ${size};\n" PARENT_SCOPE)
endfunction()

embed_file(${REGULAR} font_regular regular_src)
embed_file(${BOLD} font_bold bold_src)
file(WRITE ${OUT} "/* Generated by embed_fonts.cmake. DejaVu fonts: see assets/fonts/LICENSE. */\n${regular_src}${bold_src}")
